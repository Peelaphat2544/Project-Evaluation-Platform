# พอร์ตสำหรับรันเซิร์ฟเวอร์
PORT=3000

# รหัสโฟลเดอร์ Google Drive ของคุณครูที่แชร์ให้ Service Account (Editor)
# วิธีหา Folder ID: เปิดโฟลเดอร์ใน Google Drive -> ดู URL ด้านบน เช่น drive.google.com/drive/folders/1a2b3c4d5e... -> นำตัวอักษร 1a2b3c4d5e... มาใส่
GOOGLE_DRIVE_FOLDER_ID=

